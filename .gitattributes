# Identical bytes on every OS: Windows checkouts must not rewrite line endings. Vendored sources are verified
# by SHA-256, and shell scripts shipped in the Linux package must stay LF.
* text=auto eol=lf
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf
*.png binary
*.ico binary
*.jpg binary
*.exe binary
*.dll binary
*.whl binary
*.ttf binary
*.pt binary
*.pth binary
