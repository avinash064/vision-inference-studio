VIS_PROJECT_ROOT=/absolute/path/to/vision-inference-studio
VIS_CHAINNER_SRC_DIR=/absolute/path/to/local/chainner/src
VIS_MAX_UPLOAD_BYTES=5368709120
VITE_API_URL=http://localhost:8000
# Hugging Face access token for gated models (SAM 3) and text encoders (Grounding DINO BERT).
HF_TOKEN=hf_your_token_here

# Public Resource Hub. Secrets are read by the backend only.
ROBOFLOW_API_KEY=
KAGGLE_USERNAME=
KAGGLE_KEY=
# Preferred by current Kaggle CLI/SDK access tokens (KGAT_...).
KAGGLE_API_TOKEN=

# Optional bearer token for an OpenAI-compatible vLLM server.
VLLM_API_KEY=

# Provider-neutral local cache and extraction limits.
PUBLIC_HUB_CACHE=./workspace/public-hub
# PUBLIC_DATASET_CACHE=/fast-disk/vision-public-datasets
# PUBLIC_MODEL_CACHE=/fast-disk/vision-public-models
PUBLIC_HUB_MAX_CACHE_GB=50
PUBLIC_HUB_MAX_CONCURRENT_DOWNLOADS=2
PUBLIC_HUB_MAX_EXTRACT_GB=100
PUBLIC_HUB_MAX_FILE_GB=20

# Optional os.pathsep-separated roots accepted by the server-to-server
# Auto Annotation recipe endpoint. Browser-controlled arbitrary paths are denied.
# VIS_RECIPE_INPUT_ROOTS=/data/images:/data/media_cache

# Auto Annotation v0.1. Image-folder and direct-video paths must remain inside
# one of these os.pathsep-separated roots. Uploaded videos use opaque asset IDs.
# VIS_AUTO_ANNOTATION_INPUT_ROOTS=/data/images:/data/videos
# VIS_AUTO_ANNOTATION_ROOT=./workspace/auto-annotation
# VIS_AUTO_ANNOTATION_OUTPUT_ROOT=./workspace/auto-annotation/packages
